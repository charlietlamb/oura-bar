{
  "name": "oura-bar",
  "version": "0.1.0",
  "private": true,
  "repository": "github:charlietlamb/oura-bar",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "auth": "bun run src/cli/auth.ts",
    "fetch": "bun run src/cli/fetch.ts",
    "preview": "bun run src/cli/preview.ts",
    "build:host": "bun run src/cli/build-host.ts",
    "install:app": "bun run src/cli/install-app.ts",
    "start": "bun run build:host && bun run install:app && open \"$HOME/Applications/Oura Bar.app\"",
    "restart": "pkill -x OuraBar; bun run start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check:comments": "bun run scripts/check-comments.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun run check && bun run check:comments && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform": "0.96.1",
    "@effect/platform-bun": "0.89.0",
    "@resvg/resvg-js": "^2.6.2",
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "latest",
    "typescript": "5.9.3",
    "ultracite": "7.8.1"
  }
}
